{
  "expo": {
    "name": "stanley-paden",
    "slug": "stanley-paden-staging",
    "version": "1.2.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/images/mainLogo.png",
    "scheme": "stanleypaden",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.swiftreflex.stanleypaden",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/mainLogo.png",
        "backgroundColor": "#132440"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.swiftreflex.stanleypaden",
      "versionCode": 10
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notificationsIcon.png",
          "color": "#1A4D7A"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.swiftreflex.stanleypaden",
          "enableGooglePay": true
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "stanley-paden",
          "organization": "swift-reflex",
          "uploadSourceMaps": true
        }
      ],
      "@sentry/react-native",
      "expo-secure-store",
      "expo-asset",
      "expo-video",
      "./plugins/withPodsDeploymentTarget",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splashLogo.png",
          "resizeMode": "contain",
          "enableFullScreenImage_legacy": true,
          "backgroundColor": "#020103"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ed82ebb-1889-49c9-8925-9c793670c3f3"
      }
    },
    "owner": "shehzar-abbasi-sg",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7ed82ebb-1889-49c9-8925-9c793670c3f3",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
